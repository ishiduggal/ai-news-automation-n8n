    {
      "parameters": {
        "jsCode": "const raw = $json.text;\n\nlet data;\n\nif (typeof raw === 'string') {\n  let cleaned = raw.trim();\n\n  cleaned = cleaned\n    .replace(/^```json\\s*/i, '')\n    .replace(/^```\\s*/i, '')\n    .replace(/\\s*```$/i, '')\n    .trim();\n\n  data = JSON.parse(cleaned);\n} else {\n  data = raw;\n}\n\nfunction slugify(text) {\n  return String(text || '')\n    .toLowerCase()\n    .normalize('NFKD')\n    .replace(/[^\\w\\s-]/g, '')\n    .trim()\n    .replace(/\\s+/g, '-')\n    .replace(/-+/g, '-')\n    .slice(0, 70);\n}\n\ndata.articles = data.articles.map(article => {\n  const title = slugify(article.title);\n  const source = slugify(article.source);\n\n  return {\n    ...article,\n    article_id: `${title}-${source}`\n  };\n});\n\nreturn [\n  {\n    json: data\n  }\n];"
      },
